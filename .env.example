# MongoDB Atlas -> Database -> Connect -> Drivers -> copy the connection string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=leafwise

# Any long random string (python -c "import secrets;print(secrets.token_hex(32))")
FLASK_SECRET_KEY=PASTE_YOUR_FLASK_SECRET_KEY_HERE

# Path to the trained model produced by train.py
MODEL_PATH=model/plant_model.pt
